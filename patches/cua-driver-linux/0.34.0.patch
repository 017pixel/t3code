+    let dims: Vec<u32> = tail.split(',').filter_map(|part|
+        part.trim().trim_end_matches(')').trim().trim_start_matches("uint32 ").parse().ok()
+    ).collect();
+    match dims.as_slice() {
+        [width, height] if *width > 0 && *height > 0 => Some((png, *width, *height)),
+        _ => None,
+    }
+}
