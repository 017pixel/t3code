+
+#[cfg(target_os = "linux")]
+fn shell_helper_action_visible(actions: &mut HashMap<String, bool>, msg: &OverlayMsg) -> bool {
+    match msg {
+        OverlayMsg::Cmd(command) => {
+            match &command.cmd {
+                OverlayCommand::BeginAction { target, .. } => {
+                    actions.insert(
+                        command.key.clone(),
+                        target.is_some_and(|target| target.as_str() == "desktop"),
+                    );
+                }
+                OverlayCommand::EndAction(_) => {
+                    actions.remove(&command.key);
+                }
+                _ => {}
+            }
+            actions.get(&command.key).copied().unwrap_or(false)
+        }
+        OverlayMsg::Remove(key) | OverlayMsg::Revive(key) => {
+            actions.remove(key);
+            false
+        }
+        OverlayMsg::Wake => false,
+    }
+}
