+fn configure_background_command(command: &mut Command) {
+    // Embedded hosts run inside GUI apps, which must not open a console for
+    // their background daemon. Keep stdin piped for parent-liveness checks.
+    #[cfg(windows)]
+    command.creation_flags(0x08000000); // CREATE_NO_WINDOW
+    #[cfg(not(windows))]
+    let _ = command;
+}
